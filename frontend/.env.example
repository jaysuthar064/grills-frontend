# Frontend environment variables — committed template, NO REAL VALUES.
#
# Copy to `.env.local` (gitignored) and fill in. The authoritative registry is
# `docs/10-ENVIRONMENTS-DEPLOYMENT.md` §3.1; a variable not listed there does
# not exist, and adding one requires editing that table and this file together.
# Any NEXT_PUBLIC_* value is embedded in the client bundle and must never hold a
# secret.

# --- Required in every environment, including local ---

# WordPress origin for gotg/v1 requests. No trailing slash. Local Studio site:
WP_API_BASE_URL=http://localhost:8885
# Canonical frontend origin — canonicals, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret validating WordPress preview links. Generate: openssl rand -hex 32
PREVIEW_SECRET=
# Shared secret authenticating WordPress revalidation webhooks. Generate: openssl rand -hex 32
REVALIDATE_SECRET=
# WordPress user + Application Password for preview API authentication.
WP_PREVIEW_USER=
WP_PREVIEW_APP_PASSWORD=

# --- Required from Preview onward (integration tasks) ---

# Contact form email delivery (Resend).
RESEND_API_KEY=
CONTACT_FORM_TO=
CONTACT_FORM_FROM=
# Instagram feed identifier (Behold).
NEXT_PUBLIC_BEHOLD_FEED_ID=
# Signs static map image URLs server-side (Google Cloud). Not NEXT_PUBLIC — secret.
GOOGLE_MAPS_STATIC_API_KEY=
# Error tracking (Sentry).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Production only ---

# GA4 property, format G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Staging only (HTTP Basic protection) ---

STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASSWORD=

# VERCEL_ENV is injected by Vercel at build/runtime — do not set it here.
